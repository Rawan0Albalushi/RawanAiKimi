# Prepared environment for runpod/worker-v1-vllm:v2.30.0.
# Image-capable target. Do not paste this over the live endpoint until a
# vision boot is explicitly approved. The running endpoint still uses
# VLLM_EXTRA_ARGS=--language-model-only, which disables image inputs.
# Rollback is that flag, with LIMIT_MM_PER_PROMPT removed.
# Names below are read by src/args_builder.py or src/main.py at git tag v2.30.0.

MODEL_NAME=moonshotai/Kimi-VL-A3B-Instruct
MODEL_REVISION=398eede0903cd983a2bfa0cc634e9ac1d843f375
OPENAI_SERVED_MODEL_NAME_OVERRIDE=kimi-vl
TRUST_REMOTE_CODE=true
ENFORCE_EAGER=true
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.90
MAX_CONCURRENCY=1
VLLM_STARTUP_TIMEOUT=900
LIMIT_MM_PER_PROMPT=image=1
